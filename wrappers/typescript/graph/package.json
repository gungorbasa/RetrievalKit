{
  "name": "retrievalkit-graph",
  "version": "0.1.0",
  "private": true,
  "description": "RetrievalKit Node.js graph aggregate",
  "keywords": [
    "retrieval",
    "knowledge-graph",
    "graph-search",
    "hybrid-search",
    "local-first"
  ],
  "homepage": "https://retrievalkit-docs.gungorbasa.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gungorbasa/RetrievalKit.git",
    "directory": "wrappers/typescript/graph"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/retrievalkit.node",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build:native": "node ../scripts/build-native.mjs graph",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "os": ["darwin"],
  "cpu": ["arm64"],
  "license": "Apache-2.0"
}
